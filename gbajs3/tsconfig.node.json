{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["vite.config.ts", "scripts"]
}
